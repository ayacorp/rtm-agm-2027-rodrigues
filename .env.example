# RESEND_FROM=RTM AGM 2027 <bookings@your-domain>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Admin list / mark paid
