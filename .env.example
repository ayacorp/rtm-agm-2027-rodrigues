MCB_ACCOUNT_NAME=Round Table 9 (Reg. 17280)
MCB_BANK=MCB current
MCB_ACCOUNT_NUMBER=000443540438
MCB_IBAN=MU13MCBL0944000443540438000MUR
MCB_SWIFT=MCBLMUMU
# Optional: MCB_CHEQUES_PAYABLE=
# Optional: MCB_BANK_NAME=   (alias for MCB_BANK)

# Leave empty until organisers confirm the inbox (do not invent).
# Candidates mentioned by CoS: roundtable9.mu@gmail.com or treasurer.
BOOKING_NOTIFY_EMAIL=
# TREASURER_PHONE=

# Persistence (pick one for production). Without these, local/dev uses data/bookings.json
# and Vercel /tmp (ephemeral — not production).
# POSTGRES_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# STORE_DRIVER=           # postgres | kv | blob | file | memory

# Optional proof uploads (Vercel Blob)
# BLOB_READ_WRITE_TOKEN=

# Notify organisers (Resend preferred, else SMTP). Also needs BOOKING_NOTIFY_EMAIL.
# If unset, notifies are queued + logged.
