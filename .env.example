# Persistence (pick one for production). Without these, local/dev uses data/bookings.json
# and Vercel /tmp (ephemeral — not production).
# POSTGRES_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# STORE_DRIVER=           # postgres | kv | blob | file | memory

# Proof uploads (Vercel Blob)
# BLOB_READ_WRITE_TOKEN=

# Mail — required to actually deliver BOOKING_NOTIFY_EMAIL
# RESEND_API_KEY=
# RESEND_FROM=RTM AGM 2027 <bookings@your-domain>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Admin list / mark paid
# ADMIN_TOKEN=
