# Persistence (pick one for production). Without these, local/dev uses data/bookings.json
# and Vercel /tmp (ephemeral — not production).
# POSTGRES_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# STORE_DRIVER=           # postgres | kv | blob | file | memory

